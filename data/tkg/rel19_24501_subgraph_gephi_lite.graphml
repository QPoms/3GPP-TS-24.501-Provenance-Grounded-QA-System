<edge source="DEF" target="S1 mode to N1 mode NAS transparent container" id="e000009">
  <data key="weight">1.0</data>
  <data key="description">The S1 mode to N1 mode NAS transparent container is treated as an implicit SECURITY MODE COMMAND message for the UE and the AMF in CONNECTED mode, and is used to derive and take into use a mapped 5G NAS security context for the purpose of NAS COU.</data>
  <data key="keywords">Definition</data>
  <data key="source_id">chunk-271beb7d1fe2c1b6d63a054506e7b878</data>
  <data key="file_path">../3GPP-trunked/Rel-19/24_series/24501-j20.md4.4.3.1</data>
  <data key="created_at">1770205875</data>
