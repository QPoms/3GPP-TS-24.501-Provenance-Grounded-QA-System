</edge>
<edge source="DEF" target="SECURITY MODE COMMAND message" id="e000010">
  <data key="weight">1.0</data>
  <data key="description">The SECURITY MODE COMMAND message is implicitly</data>
  <data key="keywords">Definition</data>
  <data key="source_id">chunk-271beb7d1fe2c1b6d63a054506e7b878</data>
  <data key="file_path">../3GPP-trunked/Rel-19/24_series/24501-j20.md4.4.3.1</data>
