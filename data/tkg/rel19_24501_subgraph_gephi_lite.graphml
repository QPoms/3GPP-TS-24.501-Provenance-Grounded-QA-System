<node id="3GPP (NAUN3) device">
  <data key="entity_id">3GPP (NAUN3) device</data>
  <data key="entity_type">Concept</data>
  <data key="description">3GPP (NAUN3) device is a device defined in the present document for which specific terms and definitions are provided, related to SL Positioning Server UE and NCR-MT.</data>
  <data key="source_id">chunk-49e52242a2012fd5ddb087404c976351</data>
