<node id="Integrity protection and verification">
  <data key="entity_id">Integrity protection and verification</data>
  <data key="entity_type">Concept</data>
  <data key="description">Integrity protection and verification is a security procedure defined in subclause 4.4.3.3 that ensures the authenticity and integrity of NAS messages. The sender uses the locally stored NAS COUNT as input to the integrity protection algorithm, while the receiver uses the NAS sequence number from the received message and an estimated NAS overflow counter to form the NAS COUNT input for verification. The algorithm is specified in 3GPP TS 33.501 [24].</data>
  <data key="source_id">chunk-728e27595f36b4b4291b79a1843b7f25</data>
  <data key="file_path">../3GPP-trunked/Rel-19/24_series/24501-j20.md4.4.3.3</data>
  <data key="created_at">1770205806</data>
  <data key="source_file">Rel-19/24_series/24501-j20/graph_chunk_entity_relation.graphml</data>
  <data key="release">Rel-19</data>
  <data key="raw_entity_id">Integrity protection and verification</data>
</node>
