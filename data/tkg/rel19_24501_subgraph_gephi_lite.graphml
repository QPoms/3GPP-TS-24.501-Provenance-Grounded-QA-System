<node id="Access control">
  <data key="entity_id">Access control</data>
  <data key="entity_type">Concept</data>
  <data key="description">Access control is a security mechanism defined in section 4.5.4 that governs the ability of the UE to access network resources. It ensures that only authorized entities can perform specific actions within the network environment.</data>
  <data key="source_id">chunk-5ae68e0b66f921b4da6680f802fd62c7</data>
  <data key="file_path">../3GPP-trunked/Rel-19/24_series/24501-j20.md4.5.4</data>
