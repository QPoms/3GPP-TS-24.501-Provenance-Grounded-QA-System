<node id="5G-EA0">
  <data key="entity_id">5G-EA0</data>
  <data key="entity_type">Technology</data>
  <data key="description">5G-EA0 is a security algorithm used in 5G Non-Access Stratum (NAS) procedures for authentication and key agreement. It is referenced in the context of handling 5G NAS security.&lt;SEP&gt;5G-EA0 is a selected 5G NAS security algorithm used by the UE for security processing.</data>
  <data key="source_id">chunk-c3766b0bd2da84eace3065f40f55863c&lt;SEP&gt;chunk-2cf58586d0687b7b5ca57670c605e12e</data>
