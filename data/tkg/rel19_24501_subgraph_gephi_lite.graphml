  <data key="release">Rel-19</data>
  <data key="raw_entity_id">Access control</data>
</node>
<node id="5GS">
  <data key="entity_id">5GS</data>
  <data key="entity_type">Technology&lt;SEP&gt;UNKNOWN</data>
  <data key="description">5GS refers to the 5G System, the core network architecture of 5G, which includes enhancements for energy saving as part of its design and operational improvements.&lt;SEP&gt;Subscription and policy control mechanisms are integrated into 5GS to support energy efficiency and energy saving criteria</data>
  <data key="source_id">chunk-be5f8d76d621562b8fe270d20e89138a&lt;SEP&gt;chunk-98779b8f478b5fc3df93a5f3e4c87f5c</data>
