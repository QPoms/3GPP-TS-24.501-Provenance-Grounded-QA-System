</node>
<node id="UE doma">
  <data key="entity_id">UE doma</data>
  <data key="entity_type">Concept</data>
  <data key="description">UE doma is a concept referenced in section 4.3 and is intended to be deleted.</data>
  <data key="source_id">chunk-65f11384ffa18378873be8ecc33afe17</data>
  <data key="file_path">../3GPP-trunked/Rel-19/24_series/24501-j20.md4.3</data>
