<node id="CONNECTED mode">
  <data key="entity_id">CONNECTED mode</data>
  <data key="entity_type">Concept</data>
  <data key="description">CONNECTED mode is a state in which the UE and AMF maintain an active connection, during which the S1 mode to N1 mode NAS transparent container is treated as an implicit SECURITY MODE COMMAND message for both the UE and the AMF.</data>
  <data key="source_id">chunk-271beb7d1fe2c1b6d63a054506e7b878</data>
