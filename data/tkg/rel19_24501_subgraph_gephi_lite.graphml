  <data key="release">Rel-19</data>
  <data key="raw_entity_id">5GS&lt;SEP&gt;5GS)##</data>
</node>
<node id="core network">
  <data key="entity_id">core network</data>
  <data key="entity_type">Technology</data>
  <data key="description">The core network is the central part of the 5G System responsible for managing user sessions, mobility, and connectivity, and can be specifically targeted via subscription-based routing.</data>
  <data key="source_id">chunk-e7d1889bd63abf66975edf27a9c9e024</data>
