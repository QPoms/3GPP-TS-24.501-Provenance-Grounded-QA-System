<edge source="DEF" target="5G NAS security" id="e000007">
  <data key="weight">1.0</data>
  <data key="description">5G NAS security involves the handling of 5G-EA0 within the 5G Non-Access Stratum layer to provide authentication and key agreement between the UE and the network</data>
