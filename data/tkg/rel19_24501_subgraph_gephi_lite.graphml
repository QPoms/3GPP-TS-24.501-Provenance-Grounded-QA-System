  <data key="release">Rel-19</data>
</edge>
<edge source="subclause 5.6.1.4.2" target="CIoT small data container IE" id="e000102">
  <data key="weight">1.0</data>
  <data key="description">The UE shall decipher the value part of the CIoT small data container IE and handle the message as specified in subclause 5.6.1.4.2.</data>
