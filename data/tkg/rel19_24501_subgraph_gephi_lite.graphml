<edge source="DEF" target="Replay protection" id="e000011">
  <data key="weight">1.0</data>
  <data key="description">Replay protection assures that one and the same NAS message is not accepted twice by the receiver. Specifically, for a given 5G NAS security context, a given NAS COUNT value shall be accepted at most one time and only if message integrity verifies correctly.</data>
  <data key="keywords">Definition</data>
  <data key="source_id">chunk-1b7f566ef414e18b1d67b12d8cedbf12</data>
  <data key="file_path">../3GPP-trunked/Rel-19/24_series/24501-j20.md4.4.3.2</data>
  <data key="created_at">1770205891</data>
  <data key="source_file">Rel-19/24_series/24501-j20/graph_chunk_entity_relation.graphml</data>
  <data key="release">Rel-19</data>
</edge>
<edge source="DEF" target="Integrity protection of NAS signall" id="e000012">
  <data key="weight">1.0</data>
  <data key="description">Integrity protection of NAS signall is applied to ensure the authenticity and integrity of NAS signaling messages, preventing unauthorized modification during transmission.</data>
  <data key="keywords">Definition</data>
  <data key="source_id">chunk-87c075f0cf0189cf4a39f81e2c8777f4</data>
  <data key="file_path">../3GPP-trunked/Rel-19/24_series/24501-j20.md4.4.4</data>
  <data key="created_at">1770205934</data>
  <data key="source_file">Rel-19/24_series/24501-j20/graph_chunk_entity_relation.graphml</data>
  <data key="release">Rel-19</data>
</edge>
<edge source="DEF" target="NAS COUNT wrap around" id="e000013">
  <data key="weight">1.0</data>
  <data key="description">If, when increasing the NAS COUNT as specified above, the AMF detects that either its downlink NAS COUNT or the UE's uplink NAS</data>
  <data key="keywords">Definition</data>
  <data key="source_id">chunk-7ddc7021e3bbd564e76be4d14fa69d8c</data>
  <data key="file_path">../3GPP-trunked/Rel-19/24_series/24501-j20.md4.4.3.5</data>
